{
  "name": "@usenotra/sdk",
  "version": "2.0.0",
  "description": "The official Notra SDK: a typed API client, AI traffic middleware for every major framework, and the pinned notra.js web analytics script.",
  "keywords": [
    "notra",
    "api",
    "sdk",
    "geo",
    "ai-traffic",
    "web-analytics",
    "analytics",
    "mcp",
    "nextjs",
    "nuxt",
    "astro",
    "sveltekit",
    "tanstack",
    "react-router",
    "netlify",
    "react"
  ],
  "homepage": "https://github.com/usenotra/typescript-sdk#readme",
  "bugs": "https://github.com/usenotra/typescript-sdk/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usenotra/typescript-sdk.git"
  },
  "license": "MIT",
  "author": "Notra",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "MIGRATION.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tshy",
    "check-types": "tsc --noEmit && tsc --noEmit -p tests/tsconfig.json",
    "lint": "eslint --max-warnings=0 src scripts tests",
    "test": "bun test tests",
    "generate": "bun scripts/generate.ts",
    "sync": "bun scripts/sync-spec.ts && bun scripts/sync-notra-script.ts && bun scripts/generate.ts",
    "prepublishOnly": "bun run build"
  },
  "tshy": {
    "selfLink": false,
    "exports": {
      ".": "./src/index.ts",
      "./next": "./src/next.ts",
      "./nuxt": "./src/nuxt.ts",
      "./netlify": "./src/netlify.ts",
      "./tanstack": "./src/tanstack.ts",
      "./astro": "./src/astro.ts",
      "./sveltekit": "./src/sveltekit.ts",
      "./react-router": "./src/react-router.ts",
      "./react": "./src/react.ts",
      "./script": "./src/script.ts",
      "./mcp": "./src/mcp.ts",
      "./feedback": "./src/feedback.ts",
      "./markdown": "./src/markdown.ts",
      "./html": "./src/html.ts",
      "./geo": "./src/geo.ts",
      "./classify": "./src/classify.ts",
      "./signatures": "./src/signatures.ts",
      "./package.json": "./package.json"
    }
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@tanstack/react-start": "1.168.60",
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "globals": "15.15.0",
    "openapi-typescript": "7.13.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tshy": "3.3.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "zod": "4.6.5"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/commonjs/index.d.ts",
        "default": "./dist/commonjs/index.js"
      }
    },
    "./next": {
      "import": {
        "types": "./dist/esm/next.d.ts",
        "default": "./dist/esm/next.js"
      },
      "require": {
        "types": "./dist/commonjs/next.d.ts",
        "default": "./dist/commonjs/next.js"
      }
    },
    "./nuxt": {
      "import": {
        "types": "./dist/esm/nuxt.d.ts",
        "default": "./dist/esm/nuxt.js"
      },
      "require": {
        "types": "./dist/commonjs/nuxt.d.ts",
        "default": "./dist/commonjs/nuxt.js"
      }
    },
    "./netlify": {
      "import": {
        "types": "./dist/esm/netlify.d.ts",
        "default": "./dist/esm/netlify.js"
      },
      "require": {
        "types": "./dist/commonjs/netlify.d.ts",
        "default": "./dist/commonjs/netlify.js"
      }
    },
    "./tanstack": {
      "import": {
        "types": "./dist/esm/tanstack.d.ts",
        "default": "./dist/esm/tanstack.js"
      },
      "require": {
        "types": "./dist/commonjs/tanstack.d.ts",
        "default": "./dist/commonjs/tanstack.js"
      }
    },
    "./astro": {
      "import": {
        "types": "./dist/esm/astro.d.ts",
        "default": "./dist/esm/astro.js"
      },
      "require": {
        "types": "./dist/commonjs/astro.d.ts",
        "default": "./dist/commonjs/astro.js"
      }
    },
    "./sveltekit": {
      "import": {
        "types": "./dist/esm/sveltekit.d.ts",
        "default": "./dist/esm/sveltekit.js"
      },
      "require": {
        "types": "./dist/commonjs/sveltekit.d.ts",
        "default": "./dist/commonjs/sveltekit.js"
      }
    },
    "./react-router": {
      "import": {
        "types": "./dist/esm/react-router.d.ts",
        "default": "./dist/esm/react-router.js"
      },
      "require": {
        "types": "./dist/commonjs/react-router.d.ts",
        "default": "./dist/commonjs/react-router.js"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/esm/react.d.ts",
        "default": "./dist/esm/react.js"
      },
      "require": {
        "types": "./dist/commonjs/react.d.ts",
        "default": "./dist/commonjs/react.js"
      }
    },
    "./script": {
      "import": {
        "types": "./dist/esm/script.d.ts",
        "default": "./dist/esm/script.js"
      },
      "require": {
        "types": "./dist/commonjs/script.d.ts",
        "default": "./dist/commonjs/script.js"
      }
    },
    "./mcp": {
      "import": {
        "types": "./dist/esm/mcp.d.ts",
        "default": "./dist/esm/mcp.js"
      },
      "require": {
        "types": "./dist/commonjs/mcp.d.ts",
        "default": "./dist/commonjs/mcp.js"
      }
    },
    "./feedback": {
      "import": {
        "types": "./dist/esm/feedback.d.ts",
        "default": "./dist/esm/feedback.js"
      },
      "require": {
        "types": "./dist/commonjs/feedback.d.ts",
        "default": "./dist/commonjs/feedback.js"
      }
    },
    "./markdown": {
      "import": {
        "types": "./dist/esm/markdown.d.ts",
        "default": "./dist/esm/markdown.js"
      },
      "require": {
        "types": "./dist/commonjs/markdown.d.ts",
        "default": "./dist/commonjs/markdown.js"
      }
    },
    "./html": {
      "import": {
        "types": "./dist/esm/html.d.ts",
        "default": "./dist/esm/html.js"
      },
      "require": {
        "types": "./dist/commonjs/html.d.ts",
        "default": "./dist/commonjs/html.js"
      }
    },
    "./geo": {
      "import": {
        "types": "./dist/esm/geo.d.ts",
        "default": "./dist/esm/geo.js"
      },
      "require": {
        "types": "./dist/commonjs/geo.d.ts",
        "default": "./dist/commonjs/geo.js"
      }
    },
    "./classify": {
      "import": {
        "types": "./dist/esm/classify.d.ts",
        "default": "./dist/esm/classify.js"
      },
      "require": {
        "types": "./dist/commonjs/classify.d.ts",
        "default": "./dist/commonjs/classify.js"
      }
    },
    "./signatures": {
      "import": {
        "types": "./dist/esm/signatures.d.ts",
        "default": "./dist/esm/signatures.js"
      },
      "require": {
        "types": "./dist/commonjs/signatures.d.ts",
        "default": "./dist/commonjs/signatures.js"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/commonjs/index.js",
  "types": "./dist/commonjs/index.d.ts",
  "module": "./dist/esm/index.js"
}
